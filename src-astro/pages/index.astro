          <ul>
            <li>Designed cloud infrastructure with the other backend engineer</li>
            <li>Authored containerized microservices and API gateway in TS/Node</li>
          </ul>
        </div>
      </div>

      <div class="job">
        <div class="job-header">
          <div>
            <h3>Trinity</h3>
            <p class="tenure">11 months</p>
          </div>
        </div>

        <div class="role">
          <h4>Integration Engineer</h4>
