    </section>

    <!-- Honors & Awards Section -->
    <section class="section">
      <h2>Honors & Awards</h2>
      <ul class="awards-list">
        <li>John Philip Sousa Band Award</li>
        <li>FBLA Networking Concepts State Champion</li>
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .resume-container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 40px 20px;
    background-color: #ffffff;
    min-height: 100vh;
  }

  /* Header Section */
  .header {
    margin-bottom: 40px;
    padding-bottom: 30px;
    border-bottom: 3px solid #2c3e50;
  }

  .header-content {
    display: flex;
    align-items: center;
    gap: 30px;
  }

  .headshot-placeholder {
    width: 150px;
    height: 150px;
    min-width: 150px;
    border-radius: 50%;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
  }

  .headshot-placeholder svg {
    width: 80px;
    height: 80px;
  }

  .header-text h1 {
    margin: 0 0 8px 0;
    font-size: 2.5rem;
    color: #2c3e50;
    font-weight: 700;
  }

  .subtitle {
    margin: 0 0 4px 0;
    font-size: 1.1rem;
    color: #555;
    font-weight: 500;
  }

  .location {
    margin: 0 0 12px 0;
    color: #777;
    font-size: 0.95rem;
  }

  .contact-info {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    font-size: 0.95rem;
  }

  .contact-info a {
    color: #667eea;
    text-decoration: none;
    transition: color 0.2s;
  }

  .contact-info a:hover {
    color: #764ba2;
    text-decoration: underline;
  }

  .separator {
    color: #ccc;
  }

  /* Section Styles */
  .section {
    margin-bottom: 35px;
  }

  .section h2 {
    font-size: 1.6rem;
    color: #2c3e50;
    margin-bottom: 20px;
    padding-bottom: 8px;
    border-bottom: 2px solid #e0e0e0;
    font-weight: 600;
  }

  /* Job Styles */
  .job {
    margin-bottom: 30px;
  }

  .job-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 12px;
  }

  .job h3 {
    font-size: 1.3rem;
    color: #2c3e50;
    margin: 0;
    font-weight: 600;
  }

  .tenure {
    font-size: 0.9rem;
    color: #777;
    margin: 2px 0 0 0;
    font-style: italic;
  }

  .role {
    margin-bottom: 16px;
    padding-left: 0;
  }

  .role h4 {
    font-size: 1.1rem;
    color: #34495e;
    margin: 0 0 4px 0;
    font-weight: 600;
  }

  .date {
    font-size: 0.9rem;
    color: #777;
    margin: 0 0 4px 0;
  }

  .location-text {
    font-size: 0.9rem;
    color: #888;
    margin: 0 0 8px 0;
    font-style: italic;
  }

  .description {
    margin: 8px 0;
    line-height: 1.6;
    color: #555;
  }

  .job ul {
    margin: 8px 0 0 0;
    padding-left: 20px;
  }

  .job li {
    margin-bottom: 6px;
    line-height: 1.5;
    color: #555;
  }

  /* Education */
  .education {
    margin-bottom: 15px;
  }

  .education h3 {
    font-size: 1.2rem;
    color: #2c3e50;
    margin: 0 0 4px 0;
    font-weight: 600;
  }

  .education p {
    margin: 0;
    color: #555;
  }

  /* Skills Grid */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 30px;
  }

  .skills-grid h4 {
    font-size: 1.1rem;
    color: #34495e;
    margin: 0 0 10px 0;
    font-weight: 600;
  }

  .skill-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .skill-list li {
    padding: 6px 0;
    color: #555;
    border-bottom: 1px solid #f0f0f0;
  }

  .skill-list li:last-child {
    border-bottom: none;
  }

  /* Awards */
  .awards-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .awards-list li {
    padding: 8px 0;
    color: #555;
    border-bottom: 1px solid #f0f0f0;
  }

  .awards-list li:last-child {
    border-bottom: none;
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .header-content {
      flex-direction: column;
      text-align: center;
    }

    .header-text h1 {
      font-size: 2rem;
    }

    .contact-info {
      justify-content: center;
    }

    .headshot-placeholder {
      width: 120px;
      height: 120px;
      min-width: 120px;
    }

    .headshot-placeholder svg {
      width: 60px;
      height: 60px;
    }

    .skills-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Global Styles */
  :global(body) {
    margin: 0;
    padding: 0;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen',
      'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    background-color: #f5f5f5;
  }
</style>
