        </div>
      </div>

      <div class="job">
        <div class="job-header">
          <div>
            <h3>Colony Brands, Inc.</h3>
          </div>
        </div>
        <div class="role">
          <h4>Data Integration Analyst Intern</h4>
          <p class="date">May 2018 - August 2018 (4 months)</p>
          <p class="location-text">Monroe, Wisconsin</p>
          <ul>
            <li>Led development on a serverless data dictionary web application for the data warehouse</li>
            <li>Provided expansive business value with data provenance and metadata for all users</li>
            <li>Assisted in company-wide efforts to lift-and-shift COBOL mainframe routines to AWS</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Education Section -->
    <section class="section">
      <h2>Education</h2>
      <div class="education">
        <h3>Luther College</h3>
        <p>Data Science, Computer Science</p>
      </div>
    </section>

    <!-- Skills & Languages Section -->
    <section class="section">
      <h2>Skills & Languages</h2>
      <div class="skills-grid">
        <div>
          <h4>Top Skills</h4>
          <ul class="skill-list">
            <li>Software Development</li>
            <li>3D Printing</li>
            <li>CAD/CAM</li>
          </ul>
        </div>
        <div>
